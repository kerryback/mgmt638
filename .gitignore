# Data files
*.parquet
*.csv
# Fitted models are build artifacts too -- regenerable from the scripts in
# data/, and binary, so a re-fit adds the whole file to history again.
*.joblib

# Windows reserved device names
nul
~.xlsx

# Student records — protected, never publish. This site is public.
Course Roster.pdf
participation.csv

**/*.quarto_ipynb

# Quarto's per-document library folder. It is a build artifact and belongs
# under docs/, which the render produces; a copy next to the .qmd is a stray
# from rendering in place.
slides/*_files/
# ...and the rendered deck itself. session05-apps.html is hand-authored and
# stays tracked; anything matching sessionNN.html next to a .qmd is a render.
slides/session[0-9][0-9].html

# Course videos. They live in ~/Dropbox/mgmt638-videos and are linked from the
# decks, never committed -- a single lecture video is tens of megabytes and
# would sit in the repo's history permanently.
files/**/*.mp4
*.mp4

# Reveal's core CSS and JS render into docs/site_libs/revealjs/dist/, which the
# Python `dist/` rule above would otherwise swallow. A published deck missing
# them loads as unstyled, unnavigable HTML.
!docs/site_libs/revealjs/dist/
